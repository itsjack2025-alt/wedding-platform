# Copy this file to apps/web/.env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_PRIVATE=wedding-raw-development
AWS_S3_BUCKET_PUBLIC=wedding-processed-development

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Redis (for BullMQ in processor)
REDIS_URL=redis://localhost:6379

# Processor URL (for web app to call)
NEXT_PUBLIC_PROCESSOR_URL=http://localhost:3001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
