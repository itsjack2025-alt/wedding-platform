# ============================================================
# Wedding Platform — Production Environment Variables
# Copy this to apps/web/.env.production and fill in values
# ============================================================
# For Vercel: Add these via Dashboard → Settings → Environment Variables
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your-64-char-hex-secret-here
NEXTAUTH_URL=https://your-domain.vercel.app

# ── Processor Service ───────────────────────────────────────
# URL of your deployed processor service
NEXT_PUBLIC_PROCESSOR_URL=https://your-processor.onrender.com

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-wedding-domain.vercel.app

# ── AWS S3 ──────────────────────────────────────────────────
# Create buckets: wedding-raw-production (private) + wedding-processed-production (public)
# IAM: Create user with S3FullAccess or specific bucket policies
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_PRIVATE=wedding-raw-production
AWS_S3_BUCKET_PUBLIC=wedding-processed-production

# ── Redis (for BullMQ in processor) ──────────────────────────
# Recommended: Upstash Redis (https://upstash.com) — free tier
# Or: Redis Labs, or any Redis 6+ provider
REDIS_URL=redis://default:your-password@your-redis-host:6379

# ── OpenAI (optional — for AI categorization & captions) ─────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Cloudflare (optional — for CDN) ─────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
